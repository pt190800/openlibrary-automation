50%;\n  width: 250px;\n  height: 30px;\n  margin-left: -125px;\n  margin-top: -15px;\n  padding: 14px 0 5px;\n  border: 1px solid var(--lighter-grey);\n  text-align: center;\n  color: var(--light-grey);\n  font-size: var(--font-size-label-large);\n}\n\n.dataTables_length {\n  font-size: var(--font-size-label-medium);\n  color: var(--grey);\n  display: inline-block;\n}\n\n.dataTables_info {\n  width: 100%;\n  font-size: var(--font-size-label-medium);\n  color: var(--grey);\n  margin-top: 20px;\n}\n\n.dataTables_paginate {\n  /* stylelint-disable declaration-block-no-duplicate-properties */\n  width: 44px;\n  *width: 50px;\n  /* stylelint-enable declaration-block-no-duplicate-properties */\n  text-align: right;\n  font-size: var(--font-size-label-medium);\n  color: var(--grey);\n}\n\n/* Pagination nested */\n.paginate_disabled_previous,\n.paginate_enabled_previous,\n.paginate_disabled_next,\n.paginate_enabled_next {\n  height: 19px;\n  width: 19px;\n  margin-left: 3px;\n  float: left;\n}\n\n.paginate_disabled_previous {\n  background-image: url(/static/images/back_disabled.png);\n}\n\n.paginate_enabled_previous {\n  background-image: url(/static/images/back_enabled.png);\n}\n\n.paginate_disabled_next {\n  background-image: url(/static/images/forward_disabled.png);\n}\n\n.paginate_enabled_next {\n  background-image: url(/static/images/forward_enabled.png);\n}\n\n/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *\n * DataTables display\n */\ntable.display {\n  float: left;\n  margin: 0 auto;\n  width: 918px;\n  clear: both;\n}\n\ntable.display thead th {\n  /* stylelint-disable declaration-block-no-duplicate-properties */\n  cursor: pointer;\n  *cursor: hand;\n  /* stylelint-enable declaration-block-no-duplicate-properties */\n}\n\n/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *\n * DataTables sorting\n */\n\n.sorting_asc {\n  background-image: url(/static/images/sort_asc.png);\n  background-repeat: no-repeat;\n  background-position: 90% 10px;\n}\n\n.sorting_desc {\n  background-image: url(/static/images/sort_desc.png);\n  background-repeat: no-repeat;\n  background-position: 90% 10px;\n}\n\n.sorting {\n  background-image: url(/static/images/sort_both.png);\n  background-repeat: no-repeat;\n  background-position: 90% 10px;\n}\n\n.sorting_asc_disabled {\n  background-image: url(/static/images/sort_asc_disabled.png);\n  background-repeat: no-repeat;\n  background-position: 90% 10px;\n}\n\n.sorting_desc_disabled {\n  background-image: url(/static/images/sort_desc_disabled.png);\n  background-repeat: no-repeat;\n  background-position: 90% 10px;\n}\n\n.sorting:hover {\n  text-decoration: none;\n}\n\ntr.even,\ntr.odd {\n  border-bottom: 1px solid var(--light-grey);\n}\n\n/*\n * KeyTable\n */\ntable.KeyTable td {\n  border: 3px solid transparent;\n}\n\ntable.KeyTable td.focus {\n  border: 3px solid var(--blue-3366ff);\n}\n\ntable.display tr.gradeA {\n  background-color: var(--baby-green);\n}\n\ntable.display tr.gradeC {\n  background-color: var(--baby-blue);\n}\n\ntable.display tr.gradeX {\n  background-color: var(--baby-pink);\n}\n\ntable.display tr.gradeU {\n  background-color: var(--lighter-grey);\n}\n\ndiv.box {\n  height: 100px;\n  padding: 10px;\n  overflow: auto;\n  border: 1px solid var(--dark-baby-blue);\n  background-color: var(--baby-blue);\n}\n\n/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *\n * Misc\n */\n.dataTable_wrapper .top,\n.dataTable_wrapper .bottom {\n  padding: 15px;\n  background-color: transparent;\n  border: none;\n}\n\n.top .dataTables_info {\n  float: none;\n}\n\n.dataTables_empty {\n  text-align: center;\n  font-size: var(--font-size-label-large);\n  font-weight: normal;\n  padding: 15px 0;\n  color: var(--red);\n}\n\ntfoot input {\n  margin: 0.5em 0;\n  width: 100%;\n  color: var(--darker-grey);\n}\n\ntfoot input.search_init {\n  color: var(--grey);\n}\n\ntd.group {\n  background-color: var(--gray-d1cfd0);\n  border-bottom: 2px solid var(--gray-a19b9e);\n  border-top: 2px solid var(--gray-a19b9e);\n}\n\ntd.details {\n  background-color: var(--gray-d1cfd0);\n  border: 2px solid var(--gray-a19b9e);\n}\n\ndiv.dataTables_filter {\n  float: right;\n  text-align: right;\n  font-size: var(--font-size-label-medium);\n  margin: 0;\n  color: var(--grey);\n}\n\n.dataTables_filter input {\n  margin: 0 0 0 5px;\n  border-radius: var(--border-radius-input);\n  padding: 3px;\n  border: 1px solid var(--grey);\n}\n\n.example_alt_pagination div.dataTables_info {\n  width: 60%;\n}\n\n.paging_full_numbers {\n  width: 100%;\n  margin-top: 15px;\n  line-height: 20px;\n}\n\n.paging_full_numbers .paginate_button,\n.paging_full_numbers .paginate_active {\n  font-family: var(--font-family-body);\n  font-size: var(--font-size-label-small);\n  padding: 7px;\n  margin: 0 5px;\n  color: var(--link-blue);\n  cursor: pointer;\n}\n\n.paging_full_numbers .paginate_button:hover {\n  background: var(--link-blue);\n  color: var(--white);\n  text-decoration: none;\n}\n\n.paging_full_numbers span.paginate_active {\n  color: var(--black);\n  background-color: var(--grey-f3f3f3);\n}\n\ntable.display tr.even.row_selected td {\n  background-color: var(--blue-b0bed9);\n}\n\ntable.display tr.odd.row_selected td {\n  background-color: var(--blue-9fafd1);\n}\n\n/* For the Conditional-CSS grading rows */\n/*\n \tColour calculations (based off the main row colours)\n  Level 1:\n\t\tdd > c4\n\t\tee > d5\n\tLevel 2:\n\t  dd > d1\n\t  ee > e2\n */\ntr.odd.gradeA td.sorting_1 {\n  background-color: var(--mid-baby-green);\n}\n\ntr.odd.gradeA td.sorting_2 {\n  background-color: var(--baby-green);\n}\n\ntr.odd.gradeA td.sorting_3 {\n  background-color: var(--baby-green);\n}\n\ntr.even.gradeA td.sorting_1 {\n  background-color: var(--baby-green);\n}\n\ntr.even.gradeA td.sorting_2 {\n  background-color: var(--baby-green);\n}\n\ntr.even.gradeA td.sorting_3 {\n  background-color: var(--baby-green);\n}\n\ntr.odd.gradeC td.sorting_1 {\n  background-color: var(--mid-baby-blue);\n}\n\ntr.odd.gradeC td.sorting_2 {\n  background-color: var(--baby-blue);\n}\n\ntr.odd.gradeC td.sorting_3 {\n  background-color: var(--baby-blue);\n}\n\ntr.even.gradeC td.sorting_1 {\n  background-color: var(--baby-blue);\n}\n\ntr.even.gradeC td.sorting_2 {\n  background-color: var(--baby-blue);\n}\n\ntr.even.gradeC td.sorting_3 {\n  background-color: var(--baby-blue);\n}\n\ntr.odd.gradeX td.sorting_1 {\n  background-color: var(--mid-baby-pink);\n}\n\ntr.odd.gradeX td.sorting_2 {\n  background-color: var(--baby-pink);\n}\n\ntr.odd.gradeX td.sorting_3 {\n  background-color: var(--baby-pink);\n}\n\ntr.even.gradeX td.sorting_1 {\n  background-color: var(--baby-pink);\n}\n\ntr.even.gradeX td.sorting_2 {\n  background-color: var(--baby-pink);\n}\n\ntr.even.gradeX td.sorting_3 {\n  background-color: var(--baby-pink);\n}\n\ntr.odd.gradeU td.sorting_1 {\n  background-color: var(--mid-grey);\n}\n\ntr.odd.gradeU td.sorting_2 {\n  background-color: var(--mid-grey);\n}\n\ntr.odd.gradeU td.sorting_3 {\n  background-color: var(--mid-grey);\n}\n\ntr.even.gradeU td.sorting_1 {\n  background-color: var(--lighter-grey);\n}\n\ntr.even.gradeU td.sorting_2 {\n  background-color: var(--lighter-grey);\n}\n\ntr.even.gradeU td.sorting_3 {\n  background-color: var(--lighter-grey);\n}\n\n/*\n * Row highlighting example\n */\n.ex_highlight #example tbody tr.even:hover,\n#example tbody tr.even td.highlighted {\n  background-color: var(--lime-green);\n}\n\n.ex_highlight #example tbody tr.odd:hover,\n#example tbody tr.odd td.highlighted {\n  background-color: var(--lime-green);\n}\n\n@media only screen and (max-width: 768px) {\n  .dataTables_paginate.paging_full_numbers {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n  }\n  div.dataTables_filter {\n    float: none;\n    text-align: left;\n    margin: 5px 0 0;\n  }\n  span.number {\n    order: 4;\n    margin: 10px;\n  }\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* Slider */\n.slick-slider {\n  position: relative;\n\n  display: block;\n  box-sizing: border-box;\n\n  -webkit-user-select: none;\n  -moz-user-select: none;\n  -ms-user-select: none;\n  user-select: none;\n\n  -webkit-touch-callout: none;\n  -khtml-user-select: none;\n  -ms-touch-action: pan-y;\n  touch-action: pan-y;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.slick-list {\n  position: relative;\n\n  display: block;\n  overflow: hidden;\n\n  margin: 0;\n  padding: 0;\n}\n.slick-list:focus {\n  outline: none;\n}\n.slick-list.dragging {\n  cursor: hand;\n}\n\n.slick-slider .slick-track,\n.slick-slider .slick-list {\n  -webkit-transform: translate3d(0, 0, 0);\n  -moz-transform: translate3d(0, 0, 0);\n  -ms-transform: translate3d(0, 0, 0);\n  -o-transform: translate3d(0, 0, 0);\n  transform: translate3d(0, 0, 0);\n}\n\n.slick-track {\n  position: relative;\n  top: 0;\n  left: 0;\n\n  display: block;\n}\n.slick-track:before,\n.slick-track:after {\n  display: table;\n\n  content: \"\";\n}\n.slick-track:after {\n  clear: both;\n}\n.slick-loading .slick-track {\n  visibility: hidden;\n}\n\n.slick-slide {\n  display: none;\n  min-height: 1px;\n}\n[dir=\"rtl\"] .slick-slide {\n  float: right;\n}\n.slick-slide img {\n  display: block;\n}\n.slick-slide.slick-loading img {\n  display: none;\n}\n.slick-slide.dragging img {\n  pointer-events: none;\n}\n.slick-initialized .slick-slide {\n  display: block;\n}\n.slick-loading .slick-slide {\n  visibility: hidden;\n}\n.slick-vertical .slick-slide {\n  display: block;\n\n  height: auto;\n\n  border: 1px solid transparent;\n}\n.slick-arrow.slick-hidden {\n  display: none;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* Slider */\n.slick-loading .slick-list {\n  background: #fff url(/static/images/ajax-loader.gif) center center no-repeat;\n}\n\n/* Arrows */\n.slick-prev,\n.slick-next {\n  position: absolute;\n  top: 50%;\n\n  display: block;\n\n  margin-top: -10px;\n  padding: 0;\n\n  cursor: pointer;\n\n  color: transparent;\n  border: none;\n  outline: none;\n  background: transparent;\n}\n.slick-prev:hover,\n.slick-prev:focus,\n.slick-next:hover,\n.slick-next:focus {\n  color: transparent;\n  outline: none;\n  background: transparent;\n}\n.slick-prev:hover:before,\n.slick-prev:focus:before,\n.slick-next:hover:before,\n.slick-next:focus:before {\n  opacity: 1;\n}\n.slick-prev.slick-disabled:before,\n.slick-next.slick-disabled:before {\n  opacity: 0.25;\n}\n\n.slick-prev:before,\n.slick-next:before {\n  content: \"\";\n  display: block;\n  background: url(/static/images/icons/icon_slick-arrow-right.svg) center /\n    contain no-repeat;\n  width: 35px;\n  height: 35px;\n  opacity: 0.75;\n}\n\n.slick-prev {\n  left: -25px;\n}\n[dir=\"rtl\"] .slick-prev {\n  right: -25px;\n  left: auto;\n}\n.slick-prev:before {\n  transform: rotate(180deg);\n}\n\n.slick-next {\n  right: -25px;\n}\n[dir=\"rtl\"] .slick-next {\n  right: auto;\n  left: -25px;\n}\n[dir=\"rtl\"] .slick-next:before {\n  transform: rotate(180deg);\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* slick font is used by Carousel arrow icons */\n/* (this is a lot of bytes for just an icon so should be revisited asap) */\n\n.carousel-container .slick-slider {\n  /* allow overflow now the carousel has been initialised. */\n  overflow: visible;\n}\n\n/* Contain z-index of carousel children so arrows don't escape\n   above the sticky header. */\n.carousel-container {\n  isolation: isolate;\n}\n\n.carousel .slick-prev,\n.carousel .slick-next {\n  z-index: var(--z-index-level-4);\n}\n\n.carousel .slick-prev:before {\n  margin-left: 15px;\n}\n\n.carousel .slick-next {\n  margin-right: 11px;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"]],[[34,97]],["BODY",{"__playwright_custom_elements__":"ol-observation-form,ol-read-more,ol-chip","class":" client-js"},[[34,98]],[[34,99]],[[34,100]],[[34,101]],[[34,103]],[[34,104]],[[34,109]],[[34,110]],[[34
"property":"og:description","content":"Memoirs of a Revolutionist by Peter Kropotkin, unknown edition, "}],"\n    ","\n",["STYLE",{},"/**\n * HeaderBar (JS)\n * https://docs.openlibrary.org/designers/design-pattern-library.html#headerbar\n * This stylesheet will only apply if JS is present on the page.\n */\n\n/* Expand select to be clickable */\n.search-facet select {\n  padding: 10px;\n  top: 2px;\n  left: 2px;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* For changes in this file to take effect you must run make js instead of the usual make css because this is imported by the index.js */\n/* stylelint-disable selector-max-specificity */\n\n/* COLORBOX POP-UP */\n#colorbox,\n#cboxOverlay,\n#cboxWrapper {\n  position: absolute;\n  top: 0;\n  left: 0;\n  z-index: var(--z-index-level-17);\n}\n\n#colorbox {\n  outline: none;\n  box-sizing: content-box;\n}\n\n#colorbox > * {\n  box-sizing: content-box;\n}\n\n/* In lightboxes for displaying current cover, important the image */\n/* is not larger than available space. */\n#colorbox img {\n  height: auto;\n}\n\n#colorbox img,\n#colorbox iframe {\n  width: 100%;\n}\n\n#colorbox img.cover {\n  border-radius: 5px;\n  box-shadow: 1px 1px 2px 0 var(--book-cover-shadow-color);\n}\n\n#cboxOverlay {\n  position: fixed;\n  width: 100%;\n  height: 100%;\n  opacity: 0.5;\n  filter: alpha(opacity=50);\n  background-color: var(--black);\n}\n\n#cboxMiddleLeft,\n#cboxBottomLeft {\n  clear: left;\n}\n\n#cboxTitle {\n  margin: 0;\n  display: none !important;\n}\n\n#cboxLoadingOverlay,\n#cboxLoadingGraphic {\n  position: absolute;\n  top: 25px;\n  left: 25px;\n  width: 100%;\n}\n\n#cboxPrevious,\n#cboxNext,\n#cboxClose,\n#cboxSlideshow {\n  cursor: pointer;\n}\n\n#cboxContent {\n  box-sizing: content-box;\n  position: relative;\n  background: var(--white);\n  padding: var(--spacing-inset-sm);\n  border: 1px solid var(--dark-beige);\n  border-radius: var(--border-radius-overlay);\n  -webkit-box-shadow: 1px 3px 5px var(--darker-grey);\n  box-shadow: 1px 3px 5px var(--darker-grey);\n}\n\n#cboxLoadedContent {\n  background: var(--white);\n  margin: 0;\n  overflow: visible !important;\n}\n\n#cboxLoadedContent iframe {\n  display: block;\n  border: 0;\n}\n\n#cboxLoadingOverlay {\n  background: transparent;\n}\n\n#cboxClose {\n  display: none !important;\n  position: absolute;\n  top: 20px;\n  right: 20px;\n  width: 32px;\n  height: 32px;\n  background-image: url(/static/images/icons/icon_close-pop.png);\n  background-position: 0 0;\n  background-repeat: no-repeat;\n}\n\n#cboxClose:hover {\n  background-position: 0 -32px;\n}\n\n.dialog--close {\n  color: var(--dark-grey);\n  font-size: 1.2em;\n  /* Increase clickable area to the recommended size (44x44px) according to */\n  /* https://www.w3.org/WAI/WCAG21/Understanding/target-size.html */\n  /* but avoid modifying the UI */\n  display: inline-block;\n  position: relative;\n  z-index: var(--z-index-level-1);\n  padding: 11px 17px;\n  margin: -11px -17px;\n}\n\n.dialog--close:visited,\n.dialog--close:link,\n.dialog--close:hover {\n  text-decoration: none;\n}\n\n/* VIEW LARGER COVER POP-UP */\ndiv.coverFloat {\n  font-family: var(--font-family-body);\n  background: var(--white);\n  text-align: left;\n}\n\ndiv.coverFloat a.dialog--close:hover {\n  background-position: 0 -16px;\n}\n\ndiv.coverFloatHead {\n  display: flex;\n}\n\ndiv.coverFloatHead h2 {\n  font-weight: normal;\n  color: var(--dark-grey);\n  font-size: 1em;\n  margin: 0;\n  padding: 0;\n  flex: 1;\n}\n\n/* ADD IMAGE/COVER POP-UP */\ndiv.floater {\n  position: relative;\n  font-family: var(--font-family-body);\n  min-height: 675px;\n  background: var(--white);\n  text-align: left;\n}\n\ndiv.floaterHead {\n  display: flex;\n  padding: var(--spacing-inset-sm) var(--spacing-inset-xs);\n}\n\ndiv.floaterHead h2 {\n  font-weight: normal;\n  text-align: center;\n  color: var(--dark-grey);\n  font-size: 1.25em;\n  margin: 0;\n  padding: 0;\n  flex: 1;\n}\n\ndiv.floaterHead.right-justify {\n  justify-content: right;\n}\n\ndiv.floaterBody {\n  padding: var(--spacing-inset-md);\n  font-size: var(--font-size-label-large);\n}\n\ndiv.floaterBody p {\n  margin-bottom: var(--spacing-stack-md);\n}\n\n.floatform,\n.ol-cover-form {\n  font-family: var(--font-family-body);\n}\n\n.floatform button[type=\"submit\"],\n.ol-cover-form button[type=\"submit\"] {\n  font-size: 1em;\n  width: auto;\n  cursor: pointer;\n  display: inline-block;\n}\n\n.floatform .label,\n.ol-cover-form .label {\n  padding-bottom: var(--spacing-inset-xs);\n}\n\n.floatform .label label,\n.ol-cover-form .label label {\n  font-size: 1em;\n  font-family: var(--font-family-body);\n  font-weight: 700;\n}\n\n.floatform .label span,\n.ol-cover-form .label span {\n  font-weight: normal;\n}\n\n.floatform input[type=\"text\"],\n.floatform input[type=\"url\"],\n.floatform input[type=\"file\"],\n.ol-cover-form input[type=\"text\"],\n.ol-cover-form input[type=\"url\"],\n.ol-cover-form input[type=\"file\"] {\n  font-size: 1.125em;\n  font-family: var(--font-family-body);\n  padding: var(--spacing-inset-xs);\n}\n\n.floatform input::file-selector-button,\n.ol-cover-form input::file-selector-button {\n  cursor: pointer;\n}\n\n.floatform a,\n.ol-cover-form a {\n  cursor: pointer;\n}\n\n.ol-cover-form {\n  background-color: var(--lightest-grey);\n  border-radius: 10px;\n  padding: var(--spacing-inset-sm);\n  margin-bottom: var(--spacing-stack-sm);\n}\n\n.ol-cover-form .input {\n  display: flex;\n  gap: var(--spacing-inline-lg);\n  align-items: center;\n}\n\n.ol-cover-form .input > :first-child {\n  flex: 1;\n}\n\n.ol-cover-form button[type=\"submit\"] {\n  margin-top: 0;\n}\n\n.ol-cover-form .carousel-container {\n  padding: var(--spacing-inset-sm) 0;\n  margin: 0;\n  border-radius: 10px;\n}\n\n.ol-cover-form .carousel {\n  padding: 0;\n}\n\n.ol-cover-form .carousel__item {\n  margin: 0;\n}\n\n.ol-cover-form .book-cover {\n  height: auto;\n  flex-direction: column;\n  gap: var(--spacing-stack-sm);\n}\n\n.ol-cover-form .carousel .cta-btn {\n  color: var(--grey);\n  border: 2px solid var(--light-grey);\n  border-radius: 6px;\n  position: relative;\n}\n\n.ol-cover-form--external a {\n  text-decoration: none;\n}\n\n.ol-cover-form--external .ol-cover-form--external_image {\n  display: block;\n}\n\n.ol-cover-form--external .input {\n  flex-direction: column;\n}\n\n.ol-cover-form--external .input-container {\n  display: flex;\n  flex-direction: row;\n  gap: var(--spacing-inline-sm);\n}\n\n.ol-cover-form--external button[type=\"submit\"] {\n  width: 135px;\n}\n\n#coverFile {\n  min-width: 1px;\n}\n\n.dialog--close-parent {\n  cursor: pointer;\n}\n\ndiv#covers.input {\n  max-height: 132px;\n  overflow: hidden;\n  margin-left: -80px;\n  text-align: center;\n}\n\n.floatform__body {\n  width: 100%;\n  position: relative;\n}\n\n.floatform__body .carousel-section {\n  padding: 0 var(--spacing-inset-md);\n}\n\ndiv.imageIntro {\n  margin: 0 0 var(--spacing-stack-sm);\n}\n\n/* ADD ROLES, ETC. */\ndiv.floaterAdd {\n  position: relative;\n  font-family: var(--font-family-body);\n  background: var(--white);\n  text-align: left;\n}\n\ndiv.floaterAdd .formElement {\n  margin: 0 var(--spacing-inline-xl);\n}\n\ndiv.floaterAdd form.floatform .input {\n  padding-top: var(--spacing-inset-xs);\n}\n\ndiv.floaterAdd form.floatform .label {\n  padding-top: var(--spacing-inset-md);\n}\n\n/* stylelint-disable-next-line max-nesting-depth */\ndiv.floaterAdd form.floatform .label label {\n  font-size: 1em;\n  font-family: var(--font-family-body);\n  font-weight: 700;\n}\n\ndiv.floaterAdd form.floatform input[type=\"text\"],\ndiv.floaterAdd form.floatform textarea {\n  margin-left: 0;\n}\n\ndiv.floaterAdd form.floatform textarea {\n  padding: var(--spacing-inset-xs);\n  resize: none;\n}\n\n@media only screen and (min-width: 768px) /* @width-breakpoint-tablet */ {\n  .floatform div#covers.input,\n  .floatform .label,\n  .floatform .input {\n    width: 560px;\n    padding-top: var(--spacing-inset-md);\n  }\n\n  .floatform > div {\n    margin: 0 80px;\n    text-align: left;\n  }\n\n  .floatform input[type=\"text\"],\n  .floatform input[type=\"url\"],\n  .floatform input[type=\"file\"] {\n    width: 350px;\n  }\n\n  div.imageIntro {\n    margin: var(--spacing-stack-sm);\n  }\n\n  .floatform__body > div {\n    margin: 0 80px;\n  }\n\n  div.floaterAdd .input,\n  div.floaterAdd .label,\n  div.floaterAdd input[type=\"text\"],\n  div.floaterAdd input[type=\"url\"],\n  div.floaterAdd textarea {\n    width: 560px;\n    resize: none;\n  }\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},".native-dialog {\n  padding: 10px;\n  border: 1px solid var(--dark-beige);\n  border-radius: var(--border-radius-overlay);\n  -webkit-box-shadow: 1px 3px 5px var(--darker-grey);\n  box-shadow: 1px 3px 5px var(--darker-grey);\n}\n\n.native-dialog--close {\n  color: var(--dark-grey);\n  font-size: 1.2em;\n}\n\n.native-dialog--close:visited,\n.native-dialog--close:link,\n.native-dialog--close:hover {\n  text-decoration: none;\n}\n\n.native-dialog::backdrop {\n  opacity: 0.5;\n  background-color: var(--black);\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * FlashMessage\n * https://docs.openlibrary.org/designers/design-pattern-library.html#flashmessage\n */\n\n.flash-messages {\n  font-size: 1em;\n  font-family: var(--font-family-body);\n  clear: both;\n}\n\n.flash-messages span {\n  display: block;\n  background-color: var(--light-yellow);\n  background-position: 10px 50%;\n  background-repeat: no-repeat;\n  padding: 15px 52px;\n  text-align: left;\n  background-image: url(/static/images/icons/icon_check.png);\n}\n\n.flash-messages .error span {\n  background-image: url(/static/images/icons/icon_alert.png);\n}\n\n.flash-messages .bookadded span {\n  background: var(--light-yellow) url(/static/images/icons/icon_check.png)\n    no-repeat 40px 40px;\n  padding: 40px 40px 40px 80px;\n  position: relative;\n}\n\n.flash-messages .bookadded span span {\n  display: inline;\n  padding: 0;\n  font-family: var(--font-family-body);\n}\n\n.flash-messages .bookadded h3 {\n  font-size: 1.5em;\n  font-weight: normal;\n  margin: 0;\n  color: var(--black);\n}\n\n.flash-messages .bookadded .brown {\n  font-size: 1.125em;\n  margin: 15px 0 30px;\n}\n\n.flash-messages .bookadded .list {\n  font-size: 1.5em;\n  margin: 0;\n}\n\n.flash-messages .bookadded h3 em {\n  font-style: italic;\n  font-weight: 700;\n  color: var(--dark-green);\n}\n\n.flash-messages .bookadded .close {\n  position: absolute;\n  display: block;\n  top: 20px;\n  right: 20px;\n  width: 16px;\n  height: 16px;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/* stylelint-disable no-descending-specificity */\n.ac_results {\n  padding: 0;\n  margin: 0;\n  overflow: auto;\n  z-index: var(--z-index-level-16);\n  position: absolute;\n  display: none;\n  top: -5px;\n  max-height: 290px;\n  max-width: 600px;\n  background-color: var(--white);\n  border: 1px solid var(--light-grey);\n  opacity: 0.95;\n  text-align: left;\n  list-style: none;\n}\n\n.ac_results li {\n  margin: 0;\n  padding: 5px;\n  display: block;\n  font-family: var(--font-family-body);\n  font-size: var(--font-size-label-medium);\n  cursor: pointer;\n  color: var(--dark-grey);\n  /*\n  it is very important, if line-height not set or set\n  in relative units scroll will be broken in firefox\n  */\n  line-height: 16px;\n  overflow: hidden;\n  border-bottom: 1px solid var(--light-grey);\n}\n\n.ac_results li:last-child {\n  border-bottom: 0;\n}\n\n.ac_results li.ac_over {\n  background-color: var(--light-yellow);\n}\n\n.ac_results .ac_language {\n  font-size: var(--font-size-title-medium);\n  color: var(--black);\n}\n\n@media (pointer: coarse) {\n  .ac_results .ac_language {\n    padding: 12px 5px;\n    min-height: 44px;\n  }\n}\n\n.ac_author .action {\n  font-size: 9px;\n  color: var(--olive);\n}\n\n.ac_author .books {\n  font-size: var(--font-size-label-medium);\n  color: var(--dark-green);\n  font-weight: 700;\n  padding: 0;\n}\n\n.ac_author .subject {\n  font-size: var(--font-size-label-small);\n}\n\n.ac_author .olid {\n  font-family: var(--font-family-code);\n}\n\n.ac_author .name {\n  font-size: var(--font-size-title-medium);\n  display: block;\n  color: var(--black);\n}\n\n.ac_author .work {\n  font-size: var(--font-size-label-small);\n}\n\n/* stylelint-disable-next-line selector-max-specificity */\n.ac_author .work i {\n  color: var(--brown);\n}\n\n.ac_work .cover {\n  float: left;\n  margin-right: 5px;\n  width: 5em;\n  height: 5em;\n  overflow: hidden;\n  border-radius: 2px;\n  mask-image: linear-gradient(to top, rgba(0, 0, 0, 0), rgba(0, 0, 0, 1) 15%);\n}\n\n/* stylelint-disable-next-line selector-max-specificity */\n.ac_work .cover img {\n  width: 100%;\n}\n\n.ac_work .edition_count {\n  font-size: var(--font-size-label-medium);\n  color: var(--dark-green);\n  font-weight: 700;\n  padding: 0;\n}\n\n.ac_work .olid {\n  font-family: var(--font-family-code);\n}\n\n.ac_work .name {\n  display: block;\n  line-height: 1.1em;\n}\n\n.ac_work .title {\n  font-size: var(--font-size-title-medium);\n  color: var(--black);\n}\n\n.ac_work .first_publish_year {\n  font-size: var(--font-size-label-medium);\n}\n\n.ac_loading {\n  background: var(--white) url(/static/images/indicator.gif) right center\n    no-repeat;\n}\n\n.ac_odd {\n  background-color: var(--lightest-grey);\n}\n\n.ac_even,\n.ac_odd {\n  background-color: inherit;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},".read-statuses {\n  border-bottom: 1px solid var(--lightest-grey);\n}\n/* stylelint-disable selector-max-specificity */\n.read-statuses button.remove-from-list {\n  color: var(--red);\n}\n.read-statuses button.remove-from-list:hover {\n  color: var(--red);\n}\n/* stylelint-enable selector-max-specificity */\n.read-statuses button {\n  border: none;\n  background: none;\n  cursor: pointer;\n  color: var(--dark-grey);\n  font-weight: bold;\n  width: 100%;\n  text-align: left;\n  font-size: var(--font-size-label-medium);\n  padding: 10px;\n  border-bottom: 1px solid var(--lightest-grey);\n}\n.read-statuses button:hover {\n  color: var(--black);\n  background-color: var(--white);\n}\n/* stylelint-disable-next-line selector-max-specificity */\n.read-statuses form:last-child button.nostyle-btn {\n  border: none;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},".manageCovers {\n  max-width: 140px;\n  margin: 0 auto;\n  padding: 8px;\n  border-radius: 3px;\n  border: 3px solid var(--dark-grey);\n  background-color: var(--white);\n  color: var(--dark-grey);\n  font-size: var(--font-size-label-medium);\n  cursor: pointer;\n}\n.manageCovers a {\n  color: var(--dark-grey);\n}\n.manageCoversContainer {\n  width: 100%;\n  z-index: var(--z-index-level-16);\n}\n.manageCoversContainer a {\n  display: block;\n  text-decoration: none;\n  opacity: 0;\n}\n.manageCoversContainer a:hover,\n.manageCoversContainer a:focus {\n  text-decoration: underline;\n}\ndiv:hover > .manageCoversContainer a {\n  opacity: 0.9;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * Throbber\n * https://docs.openlibrary.org/designers/design-pattern-library.html#throbber\n * Used in openlibrary/templates/covers/change.html\n */\n\n.throbber {\n  position: absolute;\n  width: 220px;\n  height: 19px;\n  top: 120px;\n  left: 0;\n  text-align: center;\n  background-color: transparent;\n  background-image: url(/static/images/ajax-loader-bar.gif);\n  background-repeat: no-repeat;\n}\n\n.throbber h3 {\n  margin-top: 35px;\n}\n\n/* --width-breakpoint-tablet */\n@media only screen and (min-width: 768px) {\n  .throbber {\n    top: 280px;\n    left: 210px;\n  }\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},".cta-btn--available--load,\na.cta-btn--available--load {\n  background: url(/static/images/indicator.gif) center center no-repeat;\n  background-color: var(--primary-blue) !important;\n  opacity: 0.6;\n}\n.cta-btn--unavailable--load,\na.cta-btn--unavailable--load {\n  background: url(/static/images/indicator.gif) center center no-repeat;\n  background-color: var(--primary-blue) !important;\n  opacity: 0.6;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * TabPanel\n * https://docs.openlibrary.org/designers/design-pattern-library.html#tabspanel\n */\n\n.ui-tabs-nav,\n.ui-tabs-panel {\n  font-family: var(--font-family-body);\n}\n\n.ui-tabs-nav {\n  list-style: none !important;\n  margin: 0 0 18px !important;\n  clear: right;\n}\n\n.ui-tabs-nav:after {\n  /* clearing without presentational markup, IE gets extra treatment */\n  display: block;\n  clear: both;\n  content: \" \";\n}\n\n.ui-tabs-nav li {\n  list-style: none !important;\n  margin: 0 0 0 1px;\n  min-width: 54px; /* be nice to Opera */\n}\n\n.ui-tabs-nav a {\n  display: block;\n  font-weight: 600;\n  font-size: 0.6875em;\n  background: var(--white);\n  border-bottom: 3px solid var(--lightest-grey);\n  padding: 4px 8px 3px;\n  text-decoration: none;\n  text-transform: uppercase;\n  white-space: nowrap; /* required in IE 6 */\n  outline: 0; /* prevent dotted border in Firefox */\n}\n\n/* stylelint-disable max-nesting-depth */\n.ui-tabs-nav a:link,\n.ui-tabs-nav a:visited {\n  color: var(--link-blue);\n}\n\n.ui-tabs-nav a:hover {\n  color: var(--link-blue);\n  text-decoration: underline;\n}\n/* stylelint-enable max-nesting-depth */\n\n/* stylelint-disable selector-max-specificity */\n/* stylelint-disable max-nesting-depth */\n.ui-tabs-nav .ui-tabs-active a:link,\n.ui-tabs-nav .ui-tabs-active a:visited {\n  /* @ Opera, use pseudo classes otherwise it confuses cursor... */\n  background: var(--lightest-grey);\n  border: 1px solid var(--lightest-grey);\n  border-bottom: 3px solid var(--lightest-grey);\n  color: var(--teal);\n  cursor: default;\n}\n/* stylelint-enable max-nesting-depth */\n\n/* stylelint-disable no-descending-specificity */\n.ui-tabs-nav a:hover,\n.ui-tabs-nav a:focus,\n.ui-tabs-nav a:active,\n.ui-tabs-nav .ui-tabs-deselectable a:hover,\n.ui-tabs-nav .ui-tabs-deselectable a:focus,\n.ui-tabs-nav .ui-tabs-deselectable a:active {\n  /* @ Opera, we need to be explicit again here now... */\n  cursor: pointer;\n}\n/* stylelint-enable no-descending-specificity */\n/* stylelint-enable selector-max-specificity */\n\n.ui-tabs-disabled {\n  opacity: 0.4;\n  filter: alpha(opacity=40);\n}\n\n.ui-tabs-panel {\n  border: 3px solid var(--lightest-grey);\n  background: var(--white);\n  /* declare background color for container to avoid distorted fonts in IE while fading */\n}\n\n.ui-tabs-loading em {\n  padding: 0 0 0 20px;\n}\n\n/* These rules apply within overlays */\n/* e.g. when you click \"change cover\" on a books page */\n/* Need to investigate whether these can be generalised somehow. */\n.floater .ui-tabs-panel {\n  border: none;\n  background: var(--white);\n  /* declare background color for container to avoid distorted fonts in IE while fading */\n}\n\n/* Additional IE specific bug fixes... */\n* html .ui-tabs-nav {\n  /* auto clear, @ IE 6 & IE 7 Quirks Mode */\n  display: inline-block;\n}\n\n*:first-child + html .ui-tabs-nav {\n  /* @ IE 7 Standards Mode - do not group selectors,\n  otherwise IE 6 will ignore complete rule (because of the unknown + combinator)... */\n  display: inline-block;\n}\n\n/* @width-breakpoint-tablet: 768px */\n@media only screen and (min-width: 768px) {\n  .floater .ui-tabs-panel {\n    border-top: 3px solid var(--lightest-grey);\n    padding: 15px 30px !important;\n    /* declare background color for container to avoid distorted fonts in IE while fading */\n  }\n\n  .tabs-panel {\n    padding: 15px 30px 20px !important;\n  }\n\n  .ui-tabs-nav {\n    margin-bottom: -3px !important;\n  }\n\n  .ui-tabs-nav li {\n    float: left;\n  }\n\n  .ui-tabs-nav a {\n    margin: 8px 3px 0;\n  }\n\n  .ui-tabs-nav .ui-tabs-active a {\n    padding: 2px 8px 3px;\n  }\n}\n\n/* Caution! Ensure accessibility in print and other media types... */\n@media projection, screen, print {\n  /* Use class for showing/hiding tab content,\n  so that visibility can be better controlled in different media types... */\n  .ui-tabs-hide {\n    display: none;\n  }\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * UI-Dialog\n * https://docs.openlibrary.org/designers/design-pattern-library.html#ui-dialog\n */\n.ui-dialog {\n  position: relative;\n  width: 400px;\n  padding: 10px;\n  background-color: var(--white);\n  border-radius: var(--border-radius-overlay);\n  -webkit-box-shadow: 1px 3px 10px var(--black);\n  box-shadow: 1px 3px 10px var(--black);\n  z-index: var(--z-index-level-14) !important;\n}\n.ui-dialog .ui-dialog-titlebar {\n  position: relative;\n  font-weight: normal;\n  color: var(--dark-grey);\n  font-size: 1em;\n  margin: 0.2em 0;\n  padding: 8px 0;\n  display: flex;\n}\n.ui-dialog .ui-dialog-titlebar-close span {\n  display: contents;\n}\n.ui-dialog .i-dialog-title {\n  flex: 1;\n}\n.ui-dialog .ui-dialog-content {\n  padding: 0.5em 1em;\n  background: none;\n  overflow: auto;\n  zoom: 1;\n}\n.ui-dialog .ui-dialog-content p {\n  min-height: 28px;\n  padding: 6px 33px 0;\n  background: url(/static/images/icons/icon_alert.png) no-repeat 0 0;\n  margin: 0;\n}\n.ui-dialog .ui-dialog-buttonpane {\n  text-align: center;\n  margin-bottom: 10px;\n}\n.ui-dialog .ui-dialog-buttonpane button {\n  cursor: pointer;\n  width: auto;\n  overflow: visible;\n  font-size: 18px;\n  margin: 0 8px;\n}\n\n.ui-draggable .ui-dialog-titlebar {\n  display: flex;\n  cursor: move;\n}\n.ui-draggable .ui-dialog-title {\n  flex: 1;\n}\n.ui-draggable .ui-dialog-titlebar-close span {\n  display: contents;\n}\n\n* html .ui-helper-clearfix {\n  height: 1%;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * Wmd Prompt Dialog\n * https://docs.openlibrary.org/designers/design-pattern-library.html#wmdpromptdialog\n * these dialogs can be seen when wmd-button-bar icon is clicked e.g. add link\n */\n\n/* These !important's are a necessary evil.\n   They compensate for the fact that jquery.wmd.js was not written for mobile.\n   The library must be forked to be mobile friendly\n   as that library is no longer maintained.\n   Until then.. hacks! */\n/* --width-breakpoint-tablet: 768px */\n@media all and (max-width: 768px) {\n  .wmd-prompt-dialog {\n    margin-left: 10px !important;\n    margin-top: 10px !important;\n    top: 100px !important;\n    left: 0 !important;\n    right: 0 !important;\n    width: 300px !important;\n  }\n}\n\n.wmd-prompt-dialog {\n  width: 400px;\n  border: 10px solid var(--brown);\n  background-color: var(--white);\n  -webkit-border-radius: var(--border-radius-overlay);\n  -moz-border-radius: var(--border-radius-overlay);\n  border-radius: var(--border-radius-overlay);\n  -moz-box-shadow: 1px 3px 10px var(--black);\n  -webkit-box-shadow: 1px 3px 10px var(--black);\n  box-shadow: 1px 3px 10px var(--black);\n  text-align: left;\n}\n.wmd-prompt-dialog > div {\n  font-size: var(--font-size-label-large);\n  font-family: var(--font-family-body);\n  color: var(--darker-grey);\n  padding: 20px !important;\n}\n.wmd-prompt-dialog > div p {\n  margin-bottom: 0 !important;\n  position: relative;\n}\n.wmd-prompt-dialog > form {\n  width: 480px;\n  padding: 20px;\n  padding-top: 0;\n}\n.wmd-prompt-dialog > form > input[type=\"text\"] {\n  float: left;\n  margin-left: 20px !important;\n  clear: both;\n  width: 350px;\n  font-size: 1.125em;\n  font-family: var(--font-family-body);\n  padding: 3px;\n}\n.wmd-prompt-dialog > form > input[type=\"button\"] {\n  font-size: 1.125em;\n  width: auto !important;\n}\n.wmd-prompt-dialog p b {\n  display: block;\n  position: relative;\n  background-color: var(--brown);\n  padding: 0 10px 10px;\n  color: var(--white);\n  font-family: var(--font-family-body);\n  font-size: 1.75em;\n  top: -20px;\n  left: -21px;\n  width: 282px;\n}\n\n/* --width-breakpoint-tablet: 768px */\n@media all and (min-width: 768px) {\n  .wmd-prompt-dialog p b {\n    width: 380px;\n  }\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * DO NOT ADD NEW CSS here\n * Unless... you are removing an inline style and moving it into here.\n *\n * We are currently in the process of:\n * - moving styles from this file into the components\n * - removing dead code\n * - removing redundant CSS in favor of common reusable styles\n *\n * DO NOT ADD NEW CSS HERE\n */\n.ui-widget-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: var(--black);\n  opacity: 0.5;\n  filter: alpha(opacity=50);\n  z-index: var(--z-index-level-13) !important;\n}\n.ui-sortable-placeholder {\n  border: 1px dotted var(--mid-grey);\n  visibility: visible !important;\n  filter: brightness(0.85);\n  border-radius: 6px;\n}\n.ui-sortable-placeholder *,\n.ui-sortable-placeholder::before,\n.ui-sortable-placeholder::after {\n  visibility: hidden;\n}\n.ui-sortable--covers {\n  max-height: 270px;\n  overflow: auto;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"],["STYLE",{},"/**\n * Styles here will load for all users, but only if JavaScript is enabled.\n * At time of writing, this stylesheet is not render blocking.\n */\n\n/* Loading indicators */\n\n/* Book cover overlay */\n\n/* Remove items from list */\n\n/* openlibrary/plugins/openlibrary/js/subjects.js */\n.coverEbook {\n  cursor: pointer;\n  z-index: var(--z-index-level-6);\n}\n\n.coverEbook img {\n  opacity: 0.85;\n  filter: alpha(opacity=85);\n}\n\n.coverEbook a.cta-btn {\n  position: absolute;\n  padding: 0 5px;\n  right: 0;\n  bottom: 3px;\n  border-radius: 3px;\n}\n\n/* Not clear if these are needed. please review. */\n/* The on class is added inside openlibrary/plugins/openlibrary/js/ol.js */\n.tools a.on,\n.tools a.on:hover,\n.tools a.on:active {\n  color: var(--dark-grey);\n  cursor: default;\n  text-decoration: none;\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"]],"\n\n\n\n\n",["BODY",{"__playwright_custom_elements__":"ol-observation-form,ol-read-more,ol-chip","class":" client-js"},"\n  ","\n  ",["SPAN",{"id":"top"}],"\n  ",["DIV",{"id":"offline-info"},"It looks like you're offline."],"\n  \n  \n  \n\n\n\n\n\n",["DIV",{"id":"donato"},["DIV",{"class":"js-ia-donation-iframe-wrapper"},["IFRAME",{"src":"/snapshot/frame@f65dfab6e074ef0f911ca7bb2164604c","scrolling":"no","frameborder":"0","style":"width:100%; height: 100%;","title":"Banner for donating to the Internet Archive"}]],["STYLE",{},".js-ia-donation-iframe-wrapper { position: relative; height: 0px; transition: height 0.5s; } body.overflow-hidden { position: relative !important;height: auto !important; overflow: hidden !important; margin: 0 !important; } #donato .open-modal {position: fixed !important; top: 0;bottom: 0; left: 0; right: 0; z-index: 1000000 !important; } #donato .keep-above-all-dom { z-index: 10000000 !important; position: absolute; } "]],"\n","\n\n\n\n",["DIV",{"id":"topNotice"},"\n  ",["DIV",{"class":"page-banner page-banner-black page-banner-center"},"\n    ",["DIV",{"class":"iaBar"},"\n        ",["A",{"class":"iaLogo","href":"https://archive.org"},["IMG",{"__playwright_current_src__":"https://openlibrary.org/static/images/ia-logo.svg","alt":"Internet Archive logo","src":"/static/images/ia-logo.svg","width":"160"}]],"\n        \n        ",["A",{"class":"ghost-btn iabar-mobile","href":"https://archive.org/donate/?platform=ol&origin=olwww-TopNavDonateButton","data-ol-link-track":"IABar|DonateButton"},"Donate ",["SPAN",{"class":"heart","aria-hidden":"true"},"♥"]],"\n        ",["DIV",{"class":"language-component header-dropdown iabar-mobile"},"\n        ",["DETAILS",{},"\n          ",["SUMMARY",{},"\n            ",["SPAN",{},"English (en)"],"\n            ",["IMG",{"__playwright_current_src__":"https://openlibrary.org/static/images/language-icon.svg","class":"translate-icon","src":"/static/i